 public enum WidgetsStorage {
-  public static var appGroupIdentifier: String? = Bundle.main.object(forInfoDictionaryKey: "ExpoWidgetsAppGroupIdentifier") as? String
+  public static var appGroupIdentifier: String? = resolveAppGroupIdentifier()
+
+  // AltStore and SideStore re-sign with a personal team and rename every app group to
+  // "<group>.<teamID>", listing the new names under ALTAppGroups in each bundle's Info.plist.
+  // The name written at build time is then no longer one the app is entitled to, so prefer the
+  // renamed one when it is there. (Hebiebi patch.)
+  static func resolveAppGroupIdentifier() -> String? {
+    guard let base = Bundle.main.object(forInfoDictionaryKey: "ExpoWidgetsAppGroupIdentifier") as? String else {
+      return nil
+    }
+    let renamed = Bundle.main.object(forInfoDictionaryKey: "ALTAppGroups") as? [String] ?? []
+    return renamed.first(where: { $0.hasPrefix(base + ".") }) ?? base
+  }
   static let defaults = UserDefaults(suiteName: appGroupIdentifier)
 
